<?xml version="1.0" encoding="UTF-8"?>
<project xmlns=\"http://maven.apache.org/POM/4.0.0\"\n         xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0\n         https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n\n    <!-- ─────────────────────────────────────────────────────────\n         PARENT — Spring Boot provides default plugin management\n    ───────────────────────────────────────────────────────────── -->\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>4.1.0</version>\n        <relativePath/>\n    </parent>\n\n    <!-- ─────────────────────────────────────────────────────────\n         PROJECT COORDINATES Only Team Lead modifies this file.\n    ───────────────────────────────────────────────────────────── -->\n    <groupId>com.smms</groupId>\n    <artifactId>smms-backend</artifactId>\n    <version>1.0.0-SNAPSHOT</version>\n    <packaging>pom</packaging>\n    <name>SMMS Backend</name>\n    <description>Student Mentoring Management System — Maven Multi-Module Parent</description>\n\n    <!-- ─────────────────────────────────────────────────────────\n         MODULES — all 9 services declared here\n    ───────────────────────────────────────────────────────────── -->\n    <modules>\n        <module>services/discovery-server</module>\n        <module>services/config-server</module>\n        <module>services/api-gateway</module>\n        <module>services/auth-service</module>\n        <module>services/user-service</module>\n        <module>services/allocation-service</module>\n        <module>services/meeting-service</module>\n        <module>services/session-service</module>\n        <module>services/report-service</module>\n    </modules>\n\n    <!-- ─────────────────────────────────────────────────────────\n         VERSION PROPERTIES — update versions here only\n    ───────────────────────────────────────────────────────────── -->\n    <properties>\n        <java.version>21</java.version>\n        <spring-cloud.version>2025.1.2</spring-cloud.version>\n        <jjwt.version>0.12.7</jjwt.version>\n        <lombok.version>1.18.30</lombok.version>\n        <springdoc.version>2.8.5</springdoc.version>\n        <poi.version>5.3.0</poi.version>\n        <openpdf.version>2.0.2</openpdf.version>\n        <flyway.version>10.17.3</flyway.version>\n        <mapstruct.version>1.5.5.Final</mapstruct.version>\n    </properties>\n\n    <!-- ─────────────────────────────────────────────────────────\n         DEPENDENCY MANAGEMENT — BOM declarations\n         Child modules declare the dependency WITHOUT a version —\n         Maven resolves the version from here automatically.\n    ───────────────────────────────────────────────────────────── -->\n    <dependencyManagement>\n        <dependencies>\n            <!-- Spring Cloud BOM — controls all spring-cloud-* versions -->\n            <dependency>\n                <groupId>org.springframework.cloud</groupId>\n                <artifactId>spring-cloud-dependencies</artifactId>\n                <version>${spring-cloud.version}</version>\n                <type>pom</type>\n                <scope>import</scope>\n            </dependency>\n\n            <!-- JWT — Apache 2.0 licensed, free -->\n            <dependency>\n                <groupId>io.jsonwebtoken</groupId>\n                <artifactId>jjwt-api</artifactId>\n                <version>${jjwt.version}</version>\n            </dependency>\n            <dependency>\n                <groupId>io.jsonwebtoken</groupId>\n                <artifactId>jjwt-impl</artifactId>\n                <version>${jjwt.version}</version>\n                <scope>runtime</scope>\n            </dependency>\n            <dependency>\n                <groupId>io.jsonwebtoken</groupId>\n                <artifactId>jjwt-jackson</artifactId>\n                <version>${jjwt.version}</version>\n                <scope>runtime</scope>\n            </dependency>\n\n            <!-- Apache POI — Excel export (Apache 2.0) -->\n            <dependency>\n                <groupId>org.apache.poi</groupId>\n                <artifactId>poi-ooxml</artifactId>\n                <version>${poi.version}</version>\n            </dependency>\n\n            <!-- OpenPDF — PDF export (LGPL/MPL, genuinely free) -->\n            <dependency>\n                <groupId>com.github.librepdf</groupId>\n                <artifactId>openpdf</artifactId>\n                <version>${openpdf.version}</version>\n            </dependency>\n\n            <!-- Springdoc OpenAPI — Swagger UI (Apache 2.0) -->\n            <dependency>\n                <groupId>org.springdoc</groupId>\n                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>\n                <version>${springdoc.version}</version>\n            </dependency>\n\n            <!-- MapStruct — entity ↔ DTO mapping (Apache 2.0) -->\n            <dependency>\n                <groupId>org.mapstruct</groupId>\n                <artifactId>mapstruct</artifactId>\n                <version>${mapstruct.version}</version>\n            </dependency>\n            <dependency>\n                <groupId>org.mapstruct</groupId>\n                <artifactId>mapstruct-processor</artifactId>\n                <version>${mapstruct.version}</version>\n            </dependency>\n        </dependencies>\n    </dependencyManagement>\n\n    <!-- ─────────────────────────────────────────────────────────\n         COMMON DEPENDENCIES — inherited by EVERY child module\n         Keep this list minimal — service-specific deps go in\n         each service's own pom.xml, not here.\n    ───────────────────────────────────────────────────────────── -->\n    <dependencies>\n        <!-- Lombok — boilerplate reduction (MIT) -->\n        <dependency>\n            <groupId>org.projectlombok</groupId>\n            <artifactId>lombok</artifactId>\n            <optional>true</optional>\n        </dependency>\n        <!-- JUnit 5 + Mockito — testing (MIT / Apache 2.0) -->\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-test</artifactId>\n            <scope>test</scope>\n        </dependency>\n    </dependencies>\n\n\n    \n    <!-- ─────────────────────────────────────────────────────────\n         BUILD — plugin configuration inherited by all modules\n    ───────────────────────────────────────────────────────────── -->\n    <build>\n        <pluginManagement>\n            <plugins>\n                <!-- Spring Boot Maven Plugin — builds executable JARs -->\n                <plugin>\n                    <groupId>org.springframework.boot</groupId>\n                    <artifactId>spring-boot-maven-plugin</artifactId>\n                    <configuration>\n                        <excludes>\n                            <exclude>\n                                <groupId>org.projectlombok</groupId>\n                                <artifactId>lombok</artifactId>\n                            </exclude>\n                        </excludes>\n                    </configuration>\n                </plugin>\n                <!-- Maven Compiler — Java 21, enables Lombok + MapStruct annotation processing -->\n                <plugin>\n                    <groupId>org.apache.maven.plugins</groupId>\n                    <artifactId>maven-compiler-plugin</artifactId>\n                    <configuration>\n                        <source>${java.version}</source>\n                        <target>${java.version}</target>\n                        <annotationProcessorPaths>\n                            <path>\n                                <groupId>org.projectlombok</groupId>\n                                <artifactId>lombok</artifactId>\n                                <version>${lombok.version}</version>\n                            </path>\n                            <path>\n                                <groupId>org.mapstruct</groupId>\n                                <artifactId>mapstruct-processor</artifactId>\n                                <version>${mapstruct.version}</version>\n                            </path>\n                        </annotationProcessorPaths>\n                    </configuration>\n                </plugin>\n            </plugins>\n        </pluginManagement>\n    </build>

</project>
