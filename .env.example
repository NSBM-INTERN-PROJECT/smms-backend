# ─────────────────────────────────────────────────────
# SMMS Backend — Environment Variables Template
# 1. Copy this file:  cp .env.example .env
# 2. Fill in REPLACE_WITH_* values (get real values from Team Lead via private chat)
# 3. NEVER commit the .env file — it is gitignored
# ─────────────────────────────────────────────────────

# DATABASE
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
DB_USER=REPLACE_WITH_USER_NAME
DB_PASS=REPLACE_WITH_STRONG_USER_PASSWORD

# JWT — generate with:  openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# GMAIL SMTP (OTP emails + meeting reminders)
GMAIL_USERNAME=REPLACE_WITH_GMAIL_ADDRESS
GMAIL_APP_PASSWORD=REPLACE_WITH_16_CHAR_APP_PASSWORD

# SERVICE PORTS
DISCOVERY_PORT=8761
CONFIG_PORT=8888
GATEWAY_PORT=8080
AUTH_PORT=8081
USER_PORT=8082
ALLOC_PORT=8083
MEETING_PORT=8084
SESSION_PORT=8085
REPORT_PORT=8086